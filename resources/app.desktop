[Desktop Entry]
Name=Skadi Applet
Comment=Audio and media control applet for the COSMIC desktop
Type=Application
Icon=io.github.akuzko.skadi-applet
Exec=skadi-applet %F
Terminal=false
StartupNotify=true
Categories=COSMIC
Keywords=COSMIC
NoDisplay=true
X-CosmicApplet=true
X-CosmicHoverPopup=Auto
MimeType=
